BOT_TOKEN=replace_with_your_telegram_bot_token
# Optionnel: remplace les IDs admin intégrés. Format: 123456789,987654321.
ADMIN_USER_IDS=
# Local relative paths are anchored to the project directory.
# DB_PATH takes precedence over the legacy DATABASE_PATH variable.
# On Railway, mount a persistent volume at /data and set DB_PATH=/data/rabza_jugg_bot.sqlite3.
DB_PATH=rabza_jugg_bot.sqlite3
